# Website only. Add these to Vercel > Project Settings > Environment Variables.
# GA4 defaults to this stream on pocketleft.app only. Blank explicitly disables it.
# To override explicitly, use NEXT_PUBLIC_GA_MEASUREMENT_ID=G-6LLJJ52MDL.
# Sentry stays disabled until its DSN is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Source map uploads: server/build secrets, never NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
